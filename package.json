{
  "name": "ecomedia-api",
  "version": "1.0.0",
  "description": "EcoMedia API: a social network for sustainable actions (SDG 11)",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
  "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:seed": "tsx src/db/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidSaintAnna/ecomedia-api.git"
  },
  "keywords": [
    "sdg11",
    "sustainability",
    "api",
    "express"
  ],
  "author": "David Saint Anna",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DavidSaintAnna/ecomedia-api/issues"
  },
  "homepage": "https://github.com/DavidSaintAnna/ecomedia-api#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
