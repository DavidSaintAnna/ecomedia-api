# ─────────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente da API EcoMedia
#
# Como usar:
#   1. Copie este arquivo para um novo arquivo chamado ".env" (na mesma pasta)
#        Windows (PowerShell):   Copy-Item .env.example .env
#        macOS / Linux:          cp .env.example .env
#   2. Preencha os valores abaixo.
#
# ⚠️  O arquivo ".env" contém segredos. NUNCA envie para o GitHub (ele já está no .gitignore).
#     Este arquivo ".env.example" é só um modelo: não coloque senhas de verdade aqui.
# ─────────────────────────────────────────────────────────────────────────────

# Conexão com o banco PostgreSQL (OBRIGATÓRIO).
#
# Opção A – Neon (grátis, na nuvem): copie a "connection string" do painel do Neon, algo como
#   postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
#
# Opção B – PostgreSQL na sua máquina (ou Docker): por exemplo
#   postgres://postgres:postgres@localhost:5432/ecomedia
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Conexão criptografada (SSL) com o banco (OPCIONAL).
# Deixe comentado: a API decide sozinha (banco em "localhost" = sem SSL; banco na nuvem = com SSL).
# Só descomente se precisar forçar:  true  ou  false
# DATABASE_SSL=false

# Segredo usado para assinar os tokens de login (OBRIGATÓRIO, mínimo de 32 caracteres).
# Troque o valor abaixo por um texto aleatório e secreto. Para gerar um, rode no terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor

# Por quanto tempo o login vale (OPCIONAL, padrão: 7d). Exemplos: 1h, 12h, 7d
JWT_EXPIRES_IN=7d

# Porta em que a API vai rodar (OPCIONAL, padrão: 3333)
PORT=3333

# Endereço(s) do site que pode chamar a API, separados por vírgula (OPCIONAL).
# Padrão: http://localhost:5173 (o endereço do front-end React em desenvolvimento).
CORS_ORIGIN=http://localhost:5173

# Administrador criado pelo comando "npm run db:seed" (OPCIONAL).
# Se não definir, o padrão é admin@ecomedia.dev / Admin12345. Em produção, use uma senha forte!
ADMIN_EMAIL=admin@ecomedia.dev
ADMIN_PASSWORD=Admin12345
